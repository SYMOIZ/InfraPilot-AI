# InfraPilot AI — environment placeholders only. Copy to .env and fill locally.
# NEVER commit real credentials or .env files.

# Force mock Bedrock + local filesystem storage (recommended for local/dev)
DEMO_MODE=true

# AWS region (used when DEMO_MODE=false)
AWS_REGION=us-east-1
BEDROCK_REGION=

# Bedrock model id (Nova Micro recommended for lower cost)
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# When true, never use DynamoDB/S3 even if configured (local-only)
FORCE_LOCAL_STORAGE=false

# Cloud backends (set in AWS Lambda; leave empty for pure local files)
S3_BUCKET=
DYNAMODB_TABLE=

# Local persistence directory (relative to backend/ when not absolute)
LOCAL_DATA_DIR=data

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: only if you intentionally use static keys locally (prefer SSO/profiles/roles)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
